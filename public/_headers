# Cloudflare Pages-headers. JS/CSS/fonts in /_next/static hebben een hash in de naam: veilig om een jaar te cachen.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# WebP-varianten hebben een hash van de bronfoto in de naam (scripts/images.mjs): een vervangen foto krijgt een nieuwe naam.
/_img/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
